# Copy to `.env` (committed is fine — the site key is public; the secret key
# is a Pages secret, never a Vite variable). See README → Remote rooms.
VITE_TURNSTILE_SITE_KEY=

# Umami Cloud website id (public). Lives in `.env.local` (gitignored) on the
# machine that runs `npm run deploy`; unset = no analytics. See README → Analytics.
VITE_UMAMI_WEBSITE_ID=
