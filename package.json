{
  "name": "kategoria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --port 5180",
    "build": "vite build",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=kategoria --branch=main",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify:design": "node design/scripts/verify-design.mjs --pretty",
    "build:styleguide": "node design/scripts/build-style-guide.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.15.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.1.0",
    "@fontsource-variable/rubik": "5.3.0",
    "idb": "^8.0.0",
    "jsqr": "^1.4.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4"
  }
}
