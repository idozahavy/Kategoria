{
  "$schema": "./tokens.schema.json",
  "$description": "Kategoria design tokens — single source of truth. Candy Pop direction, C2 teal-lead palette. Semantic tokens reference primitives; every raw value appears exactly once.",
  "version": "0.3.0",
  "color": {
    "primitive": {
      "cream-50": { "$type": "color", "$value": "#FFF8F0" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "sand-200": { "$type": "color", "$value": "#F3E7DA" },
      "sand-300": { "$type": "color", "$value": "#D9C8B8" },
      "brown-600": { "$type": "color", "$value": "#7A6E71" },
      "brown-900": { "$type": "color", "$value": "#3D3436" },
      "teal-600": { "$type": "color", "$value": "#0E7C72" },
      "teal-800": { "$type": "color", "$value": "#084F48" },
      "pink-600": { "$type": "color", "$value": "#C61E72" },
      "pink-800": { "$type": "color", "$value": "#8F1252" },
      "orange-400": { "$type": "color", "$value": "#FF9A3D" },
      "orange-900": { "$type": "color", "$value": "#4A2800" },
      "green-700": { "$type": "color", "$value": "#227A2C" },
      "red-700": { "$type": "color", "$value": "#C22328" },
      "red-900": { "$type": "color", "$value": "#8F181C" },
      "grape-600": { "$type": "color", "$value": "#6D41E0" },
      "grape-800": { "$type": "color", "$value": "#4C27AA" },
      "amber-700": { "$type": "color", "$value": "#B45309" },
      "blue-700": { "$type": "color", "$value": "#1D4ED8" },
      "pink-700": { "$type": "color", "$value": "#BE185D" },
      "stone-600": { "$type": "color", "$value": "#57534E" },
      "cocoa-900": { "$type": "color", "$value": "#241B1D" },
      "cocoa-800": { "$type": "color", "$value": "#332528" },
      "cocoa-600": { "$type": "color", "$value": "#4A3A3E" },
      "cocoa-500": { "$type": "color", "$value": "#5C4950" },
      "cream-200": { "$type": "color", "$value": "#F5EDE7" },
      "mauve-300": { "$type": "color", "$value": "#B8A8AB" },
      "teal-300": { "$type": "color", "$value": "#3DD6C6" },
      "teal-500": { "$type": "color", "$value": "#23A296" },
      "teal-950": { "$type": "color", "$value": "#06302B" },
      "pink-300": { "$type": "color", "$value": "#FF7AB8" },
      "pink-500": { "$type": "color", "$value": "#C4488A" },
      "pink-950": { "$type": "color", "$value": "#4A0A28" },
      "orange-300": { "$type": "color", "$value": "#FFB061" },
      "green-300": { "$type": "color", "$value": "#7EDB8A" },
      "green-950": { "$type": "color", "$value": "#0A3D12" },
      "red-300": { "$type": "color", "$value": "#FF8A8E" },
      "red-500": { "$type": "color", "$value": "#C4585C" },
      "red-950": { "$type": "color", "$value": "#4A0A0C" },
      "lavender-300": { "$type": "color", "$value": "#C4A8FF" },
      "grape-950": { "$type": "color", "$value": "#2A1060" },
      "blue-300": { "$type": "color", "$value": "#7FA8FF" },
      "blue-950": { "$type": "color", "$value": "#0A1A4A" },
      "rose-200": { "$type": "color", "$value": "#FF9CC9" },
      "stone-300": { "$type": "color", "$value": "#C9C4BE" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "{color.primitive.cream-50}" },
      "surface": { "$type": "color", "$value": "{color.primitive.white}" },
      "text": { "$type": "color", "$value": "{color.primitive.brown-900}" },
      "muted": { "$type": "color", "$value": "{color.primitive.brown-600}" },
      "border": { "$type": "color", "$value": "{color.primitive.sand-200}" },
      "border-strong": { "$type": "color", "$value": "{color.primitive.sand-300}" },
      "primary": { "$type": "color", "$value": "{color.primitive.teal-600}" },
      "primary-edge": { "$type": "color", "$value": "{color.primitive.teal-800}" },
      "on-primary": { "$type": "color", "$value": "{color.primitive.white}" },
      "accent": { "$type": "color", "$value": "{color.primitive.pink-600}" },
      "accent-edge": { "$type": "color", "$value": "{color.primitive.pink-800}" },
      "on-accent": { "$type": "color", "$value": "{color.primitive.white}" },
      "warning": { "$type": "color", "$value": "{color.primitive.orange-400}" },
      "on-warning": { "$type": "color", "$value": "{color.primitive.orange-900}" },
      "success": { "$type": "color", "$value": "{color.primitive.green-700}" },
      "on-success": { "$type": "color", "$value": "{color.primitive.white}" },
      "danger": { "$type": "color", "$value": "{color.primitive.red-700}" },
      "danger-edge": { "$type": "color", "$value": "{color.primitive.red-900}" },
      "on-danger": { "$type": "color", "$value": "{color.primitive.white}" },
      "focus": { "$type": "color", "$value": "{color.primitive.grape-600}" },
      "scrim": { "$type": "color", "$value": "{color.primitive.brown-900}" },
      "player-1": { "$type": "color", "$value": "{color.primitive.teal-600}" },
      "player-2": { "$type": "color", "$value": "{color.primitive.pink-600}" },
      "player-3": { "$type": "color", "$value": "{color.primitive.amber-700}" },
      "player-4": { "$type": "color", "$value": "{color.primitive.grape-600}" },
      "player-5": { "$type": "color", "$value": "{color.primitive.blue-700}" },
      "player-6": { "$type": "color", "$value": "{color.primitive.green-700}" },
      "player-7": { "$type": "color", "$value": "{color.primitive.pink-700}" },
      "player-8": { "$type": "color", "$value": "{color.primitive.stone-600}" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "{color.primitive.cocoa-900}" },
      "surface": { "$type": "color", "$value": "{color.primitive.cocoa-800}" },
      "text": { "$type": "color", "$value": "{color.primitive.cream-200}" },
      "muted": { "$type": "color", "$value": "{color.primitive.mauve-300}" },
      "border": { "$type": "color", "$value": "{color.primitive.cocoa-600}" },
      "border-strong": { "$type": "color", "$value": "{color.primitive.cocoa-500}" },
      "primary": { "$type": "color", "$value": "{color.primitive.teal-300}" },
      "primary-edge": { "$type": "color", "$value": "{color.primitive.teal-500}" },
      "on-primary": { "$type": "color", "$value": "{color.primitive.teal-950}" },
      "accent": { "$type": "color", "$value": "{color.primitive.pink-300}" },
      "accent-edge": { "$type": "color", "$value": "{color.primitive.pink-500}" },
      "on-accent": { "$type": "color", "$value": "{color.primitive.pink-950}" },
      "warning": { "$type": "color", "$value": "{color.primitive.orange-300}" },
      "on-warning": { "$type": "color", "$value": "{color.primitive.orange-900}" },
      "success": { "$type": "color", "$value": "{color.primitive.green-300}" },
      "on-success": { "$type": "color", "$value": "{color.primitive.green-950}" },
      "danger": { "$type": "color", "$value": "{color.primitive.red-300}" },
      "danger-edge": { "$type": "color", "$value": "{color.primitive.red-500}" },
      "on-danger": { "$type": "color", "$value": "{color.primitive.red-950}" },
      "focus": { "$type": "color", "$value": "{color.primitive.lavender-300}" },
      "scrim": { "$type": "color", "$value": "{color.primitive.cocoa-900}" },
      "player-1": { "$type": "color", "$value": "{color.primitive.teal-300}" },
      "player-2": { "$type": "color", "$value": "{color.primitive.pink-300}" },
      "player-3": { "$type": "color", "$value": "{color.primitive.orange-300}" },
      "player-4": { "$type": "color", "$value": "{color.primitive.lavender-300}" },
      "player-5": { "$type": "color", "$value": "{color.primitive.blue-300}" },
      "player-6": { "$type": "color", "$value": "{color.primitive.green-300}" },
      "player-7": { "$type": "color", "$value": "{color.primitive.rose-200}" },
      "player-8": { "$type": "color", "$value": "{color.primitive.stone-300}" },
      "$description": "Dark = warm cocoa. Buttons flip to bright candy fills with dark on-* text to keep AA. Player avatar text is cocoa-900 on these bright fills."
    }
  },
  "typography": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["Nunito Variable", "Rubik Variable", "Segoe UI", "system-ui", "sans-serif"], "$description": "Self-hosted via @fontsource-variable: Nunito draws Latin + Cyrillic; Nunito has no Hebrew or Arabic glyphs, so Rubik (rounded, same weights) draws those. Family names must match the fontsource @font-face names. Never load from an external URL." }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "40px" },
      "h1": { "$type": "dimension", "$value": "28px" },
      "h2": { "$type": "dimension", "$value": "22px" },
      "body": { "$type": "dimension", "$value": "17px" },
      "small": { "$type": "dimension", "$value": "14px" }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": 800 },
      "heading": { "$type": "fontWeight", "$value": 800 },
      "subheading": { "$type": "fontWeight", "$value": 700 },
      "body": { "$type": "fontWeight", "$value": 600 }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 1.15 },
      "h1": { "$type": "number", "$value": 1.2 },
      "h2": { "$type": "number", "$value": 1.3 },
      "body": { "$type": "number", "$value": 1.5 },
      "small": { "$type": "number", "$value": 1.4 }
    },
    "numeric": {
      "scores": { "$type": "fontFeature", "$value": "tabular-nums", "$description": "Scores and timers always use tabular figures." }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px", "$description": "Buttons, inputs" },
    "lg": { "$type": "dimension", "$value": "24px", "$description": "Cards, panels" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Chips, timer pill" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "2px" },
    "edge-width": { "$type": "dimension", "$value": "5px", "$description": "Pressable button bottom edge" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "4px", "blur": "12px", "color": "rgba(61,52,54,0.10)" } }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "press": { "$type": "duration", "$value": "350ms" },
      "enter": { "$type": "duration", "$value": "300ms" },
      "pulse": { "$type": "duration", "$value": "600ms" }
    },
    "easing": {
      "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "Bouncy-toy overshoot — presses, pops, celebrations" },
      "standard": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1], "$description": "Plain ease-out for fades/slides" }
    },
    "rules": {
      "$description": "Motion only as feedback/celebration; NEVER animate while players are typing or thinking. Reduced-motion: replace all movement/scaling with a 150ms linear fade; timer warning becomes color-only."
    }
  },
  "size": {
    "touch": { "$type": "dimension", "$value": "48px", "$description": "Minimum touch target (buttons, inputs, icon buttons) — hard rule 2" },
    "touch-chip": { "$type": "dimension", "$value": "44px", "$description": "Minimum touch target for chips and inline chip controls" }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 100 },
    "modal": { "$type": "number", "$value": 110 },
    "toast": { "$type": "number", "$value": 120 }
  }
}
